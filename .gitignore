# ====================================================================
# 1. GRADLE & BUILD OUTPUTS
# ====================================================================
.gradle/
**/build/
!**/src/**/build/

# Cache do Gradle
.gradletasknamecache
gradle-app.setting

# Garantir que o Gradle Wrapper NÃO é ignorado (essencial para a pipeline)
!gradle-wrapper.jar
!gradle-wrapper.properties

# ====================================================================
# 2. IDEs (IntelliJ IDEA & Eclipse)
# ====================================================================
# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/
!**/src/**/out/

# Eclipse
.project
.classpath
.settings/
.factorypath

# ====================================================================
# 3. BASE DE DADOS (Neo4j Local / Docker) & CACHE
# ====================================================================
# Ignorar dados locais da BD se correrem dentro da pasta do projeto
**/data/
**/logs/
.modules/

# Cache local do Redis (se aplicável)
dump.rdb

# ====================================================================
# 4. FRONTEND (React / TypeScript - Sprint 3)
# ====================================================================
# Dependências do Node
**/node_modules/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# Compilação do Frontend
**/dist/
**/build-frontend/

# ====================================================================
# 5. SISTEMA OPERATIVO & CONFIGURAÇÕES PESSOAIS
# ====================================================================
# Ficheiros de sistema
Keep.me
*.DS_Store
Thumbs.db

# Variáveis de ambiente locais (Segredos / Chaves de API)
.env
.env.local
.env.*.local